# =============================================================================
# GitHub Repository AI Assistant - backend configuration
# Copy this file to `.env` and fill in the values you need.
#   cp .env.example .env          (macOS/Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
# =============================================================================

# --- LLM (required for /ask and /summary) ------------------------------------
# Create a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# `gemini-flash-latest` always resolves to the current Flash model, so it keeps
# working as Google retires older versions (gemini-2.5-flash is already closed
# to new keys). Pin a concrete model such as gemini-3.6-flash for stable output.
GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048
# Gemini 3 reasoning depth: minimal | low | medium | high (empty = model default).
# "minimal" answers noticeably faster with comparable quality on code questions;
# models that do not support the setting silently fall back to their default.
GEMINI_THINKING_LEVEL=minimal

# --- GitHub (optional) -------------------------------------------------------
# A classic/fine-grained token with no scopes is enough; it only raises the
# metadata rate limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# --- Server ------------------------------------------------------------------
DEBUG=false
LOG_LEVEL=INFO
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave empty to expose routes as /clone, /ask, /status ... Set to e.g. "/api"
# to namespace them (remember to update the frontend VITE_API_BASE_URL too).
API_PREFIX=

# --- Embeddings (runs locally, no API cost) ----------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64

# --- Chunking ----------------------------------------------------------------
CHUNK_SIZE=1200
CHUNK_OVERLAP=180

# --- Retrieval ---------------------------------------------------------------
RETRIEVAL_TOP_K=8
SUMMARY_TOP_K=5
# Cosine distance (0..2) above which a match is discarded as irrelevant.
MAX_MATCH_DISTANCE=1.55

# --- Scanning limits ---------------------------------------------------------
MAX_FILE_SIZE_BYTES=400000
MAX_FILES_PER_REPO=4000
MAX_TOTAL_BYTES=40000000
CLONE_DEPTH=1
CLONE_TIMEOUT_SECONDS=300

# --- Storage (relative paths resolve against ./backend) ----------------------
REPOSITORIES_DIR=repositories
CHROMA_DIR=chroma_db
